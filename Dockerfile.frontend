# Simple single-stage build for ECS
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Copy application
COPY . .

# Build arguments for environment variables
ARG NEXT_PUBLIC_BACKEND_URL
ARG STREAMSMART_AWS_ACCESS_KEY_ID
ARG STREAMSMART_AWS_SECRET_ACCESS_KEY
ARG STREAMSMART_AWS_REGION

# Set environment variables for build
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV STREAMSMART_AWS_ACCESS_KEY_ID=$STREAMSMART_AWS_ACCESS_KEY_ID
ENV STREAMSMART_AWS_SECRET_ACCESS_KEY=$STREAMSMART_AWS_SECRET_ACCESS_KEY
ENV STREAMSMART_AWS_REGION=$STREAMSMART_AWS_REGION

# Build Next.js
RUN npm run build

# Expose port
EXPOSE 3000

ENV PORT=3000

# Start Next.js
CMD ["npm", "start"]
