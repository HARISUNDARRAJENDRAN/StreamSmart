# StreamSmart Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# AWS Cognito Configuration
NEXT_PUBLIC_AWS_REGION=your-aws-region
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your-user-pool-id
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-client-id
NEXT_PUBLIC_COGNITO_DOMAIN=your-cognito-domain

# YouTube API
NEXT_PUBLIC_YOUTUBE_API_KEY=your-youtube-api-key
NEXT_COGNITO_CLIENT_ID=your-cognito-client-id

# AWS Credentials
AWS_PROFILE=your-aws-profile
AWS_REGION=your-region
AWS_ACCOUNT_ID=your-account-id

# AWS Bedrock Configuration
AWS_BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0

# AWS OpenSearch Configuration
OPENSEARCH_ENDPOINT=your-opensearch-endpoint
OPENSEARCH_VIDEO_INDEX=streamsmart-rag-chunks

# AWS ElastiCache Redis Configuration
AWS_ELASTICACHE_HOST=your-redis-host
AWS_ELASTICACHE_PORT=6379
AWS_ELASTICACHE_TLS=false

# AWS S3 Configuration
S3_TRANSCRIPT_BUCKET=your-transcript-bucket
AWS_RAG_S3_BUCKET=your-rag-bucket

# AWS DynamoDB Tables Region
STREAMSMART_AWS_REGION=your-region
STREAMSMART_AWS_ACCESS_KEY_ID=your-access-key
STREAMSMART_AWS_SECRET_ACCESS_KEY=your-secret-key

# RAG Configuration
AWS_RAG_OPENSEARCH_ENDPOINT=your-opensearch-endpoint
AWS_RAG_OPENSEARCH_INDEX=streamsmart-rag-chunks
AWS_RAG_EMBED_MODEL=amazon.titan-embed-text-v2
AWS_RAG_LLM_MODEL=amazon.titan-text-express-v1

# BERT Backend Configuration
USE_DYNAMODB=true
VIDEOS_TABLE=Videos

# Amazon Lex Configuration
NEXT_PUBLIC_LEX_BOT_ID=your-bot-id
NEXT_PUBLIC_LEX_BOT_ALIAS_ID=your-alias-id
NEXT_PUBLIC_LEX_LOCALE_ID=en_US
NEXT_PUBLIC_LEX_REGION=us-east-1
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=your-access-key
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=your-secret-key

# AI Recommendation Service
NEXT_PUBLIC_AI_RECOMMENDATION_API=your-recommendation-api
NEXT_PUBLIC_AI_HEALTH_CHECK=your-health-check-endpoint
NEXT_PUBLIC_ENABLE_AI_RECOMMENDATIONS=true

# JWT Secret (for production)
JWT_SECRET=your-secure-jwt-secret-key

# Production Backend URL (set after deployment)
NEXT_PUBLIC_BACKEND_URL=https://your-backend-url
